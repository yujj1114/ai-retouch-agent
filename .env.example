# Retouch Agent 本地代理配置
# 用法：复制本文件为 .env（与本文件同级，即项目根目录），填入 Key 后运行 node server/proxy.js
# API Key 获取：阿里云百炼控制台 https://bailian.console.aliyun.com/ → API-KEY 管理

# 【必填】DashScope API Key（sk- 开头）
DASHSCOPE_API_KEY=

# 【可选】上游地址；业务空间可改为专属域名 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# 【可选】代理监听端口（也可用 node server/proxy.js --port 9090 覆盖）
PROXY_PORT=8619

# ---- 以下模型名在「设置」面板中同样可配，两边一致即可 ----
# PLANNER_MODEL=qwen-plus          # Agent 规划模型
# IMAGE_MODEL=qwen-image           # 文生图模型
# IMAGE_SIZE=1024x1024             # 文生图尺寸
